#!/bin/sh
# Sets the postgres role's password to the value this apply rendered, before
# flyway connects with it as that role: every apply leaves the role's password
# equal to the rendered secret, so a rotation takes effect at the next one, for
# flyway and for every service reaching postgres through PgBouncer.
#
# The statements are wrapped in one session with statement logging off, so the
# password never lands in postgres's log, and psql's backtick reads the secret
# inside the container: it is never an argument here and this hook prints it
# nowhere.
set -eu

result() {
	printf '{"message":"%s"}' "$1" >&"${ERP_RESULT_FD:-3}"
}

fail() {
	printf 'db-password: %s\n' "$1" >&2
	printf '{"message":"%s"}' "$1" >&"${ERP_RESULT_FD:-3}"
	exit 1
}

if [ "${ERP_DRY_RUN:-0}" = 1 ]; then
	printf '{"message":"would set the postgres role password from the rendered secret","skipped":true}' >&"${ERP_RESULT_FD:-3}"
	exit 0
fi

project=${ERP_COMPOSE_PROJECT:-erp}

# The postgres container of this project, by the labels Compose puts on it,
# stopped or running: a cold backup leaves postgres stopped, and this step has
# to leave the role matching the secret either way.
if ! container=$(
	docker ps --all --quiet \
		--filter "label=com.docker.compose.project=${project}" \
		--filter label=com.docker.compose.service=postgres
); then
	fail "docker ps did not answer"
fi
container=$(printf '%s\n' "$container" | sed -n '1p')

# No container at all: the release has not been applied here, so there is no
# role of this project's to set and nothing to do.
if [ -z "$container" ]; then
	printf '{"message":"no postgres container of the %s project","skipped":true}' "${project}" >&"${ERP_RESULT_FD:-3}"
	exit 0
fi

if ! running=$(docker inspect --format '{{.State.Running}}' "$container"); then
	fail "could not read the state of the postgres container"
fi
if [ "${running}" != true ]; then
	if ! docker start "$container" >/dev/null; then
		fail "could not start the postgres container"
	fi
fi

waited=0
while [ "${waited}" -lt 60 ]; do
	if docker exec "$container" pg_isready -U postgres -d postgres >/dev/null 2>&1; then
		break
	fi
	sleep 1
	waited=$((waited + 1))
done
[ "${waited}" -lt 60 ] || fail "postgres did not answer pg_isready within 60s"

# An absent or empty secret would set an empty password, locking every reader
# out; a release always renders it, so this is a failure, not a skip.
if ! docker exec "$container" sh -c 'test -s /run/secrets/postgres_password'; then
	fail "the postgres container has no /run/secrets/postgres_password to set"
fi

# ON_ERROR_STOP=1: the ALTER's failure is this command's. The SETs come first
# so the statement carrying the password is not logged by the server.
if ! docker exec --interactive "$container" \
	psql -U postgres -d postgres -v ON_ERROR_STOP=1 <<'SQL'
SET log_statement = 'none';
SET log_min_duration_statement = -1;
SET log_min_error_statement = panic;
\set pw `cat /run/secrets/postgres_password`
ALTER ROLE postgres PASSWORD :'pw';
SQL
then
	fail "psql could not set the postgres role password"
fi

result "the postgres role password matches the rendered secret"