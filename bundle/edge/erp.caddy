# Imported into the caddy image's site block, which already answers its health
# path, limits the body and runs the WAF. One origin: the API and its MCP
# metadata go to the backend, everything else to the frontend.
@backend path /v1 /v1/* /mcp /mcp/* /health /.well-known/oauth-protected-resource*

handle @backend {
	reverse_proxy backend:8000
}

handle {
	reverse_proxy frontend:8080
}
