set quiet
set shell := ["bash", "-cu"]

# ----------------------- #

_nrdir := "/home/nonroot"
_secrets_env := _nrdir / "secrets_env"
_flags := "--env-file " + _secrets_env
_gh_token := _nrdir / "gh-token"

# ----------------------- #

login:
    echo $(cat {{ _gh_token }}) | docker login ghcr.io -u dummy --password-stdin

install: login
    docker compose {{ _flags }} up -d --build

upgrade: login
    docker compose {{ _flags }} up -d --build

uninstall wipe='': login
    @echo "Wiping volumes: {{ wipe }}"
    if [ "{{ wipe }}" = "true" ]; then \
        docker compose {{ _flags }} down --volumes --remove-orphans; \
    else \
        docker compose {{ _flags }} down; \
    fi